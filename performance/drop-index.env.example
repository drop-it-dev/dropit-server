# Windows에서 Spring API를 확인하는 주소
HEALTH_CHECK_URL=http://localhost:8080

# Docker k6 컨테이너에서 Windows의 Spring API에 접근하는 주소
BASE_URL=http://host.docker.internal:8080

# 로컬 성능 테스트 전용 계정
